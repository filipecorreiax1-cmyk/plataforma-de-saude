generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  NURSE
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  passwordHash    String
  cpf             String        @unique
  susCard         String?
  phone           String
  role            Role          @default(PATIENT)
  active          Boolean       @default(true)
  twoFactorSecret String?
  twoFactorOn     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  privacyNoticeAcceptedAt DateTime?
  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")
  auditEvents     AuditEvent[]
  availableSlots  ScheduleSlot[]
  healthUnitAssignments HealthUnitDoctor[]
  doctorPeriodSchedules DoctorPeriodSchedule[]
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  doctorId    String
  startsAt    DateTime
  specialty   String
  unit        String
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  cancelledAt DateTime?
  periodScheduleId String?
  periodSchedule DoctorPeriodSchedule? @relation(fields: [periodScheduleId], references: [id], onDelete: SetNull)
  slotId      String?       @unique
  slot        ScheduleSlot? @relation(fields: [slotId], references: [id])
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  @@index([doctorId, startsAt])
  @@index([periodScheduleId, status])
  @@index([patientId, startsAt])
}

model Vaccine {
  id          String   @id @default(uuid())
  name        String
  description String
  targetGroup String
  doses       String
  active      Boolean  @default(true)
  imageData   String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model ImmunizationEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  unit        String
  imageData   String?  @db.Text
  active      Boolean  @default(true)
  archivedAt  DateTime?
  parentCampaignId String?
  parentCampaign ImmunizationEvent? @relation("CampaignEditions", fields: [parentCampaignId], references: [id], onDelete: SetNull)
  editions    ImmunizationEvent[] @relation("CampaignEditions")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([startsAt, endsAt, active])
  @@index([parentCampaignId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([actorId, createdAt])
}

model ScheduleSlot {
  id        String       @id @default(uuid())
  doctorId  String
  startsAt  DateTime
  specialty String
  unit      String
  isOpen    Boolean      @default(true)
  createdAt DateTime     @default(now())
  doctor    User         @relation(fields: [doctorId], references: [id])
  healthUnitId String?
  healthUnit HealthUnit? @relation(fields: [healthUnitId], references: [id], onDelete: SetNull)
  appointment Appointment?
  @@unique([doctorId, startsAt])
  @@index([startsAt, isOpen])
  @@index([healthUnitId, startsAt, isOpen])
}

model HealthUnit {
  id           String   @id @default(uuid())
  name         String
  address      String
  phone        String?
  municipality String
  coverageArea String?
  latitude     Float?
  longitude    Float?
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  doctors      HealthUnitDoctor[]
  scheduleSlots ScheduleSlot[]
  periodSchedules DoctorPeriodSchedule[]
  @@unique([name, municipality])
  @@index([municipality, active])
}

model HealthUnitDoctor {
  id          String     @id @default(uuid())
  healthUnitId String
  doctorId    String
  createdAt   DateTime   @default(now())
  healthUnit  HealthUnit @relation(fields: [healthUnitId], references: [id], onDelete: Cascade)
  doctor      User       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@unique([healthUnitId, doctorId])
  @@index([doctorId])
}

model DoctorPeriodSchedule {
  id          String   @id @default(uuid())
  doctorId    String
  healthUnitId String
  date        DateTime @db.Date
  period      String
  startsAt    DateTime
  endsAt      DateTime
  specialty   String
  capacity    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctor      User       @relation(fields: [doctorId], references: [id])
  healthUnit  HealthUnit @relation(fields: [healthUnitId], references: [id])
  appointments Appointment[]
  @@unique([doctorId, healthUnitId, date, period])
  @@index([healthUnitId, date, period, active])
  @@index([doctorId, date, active])
}
